<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="50dp">

            <!-- Decoración superior -->
            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:rotation="180"
                android:scaleType="fitXY"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/marco_inferior" />

            <!-- Foto de Perfil -->
            <ImageView
                android:id="@+id/photoPerfil"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="36dp"
                android:padding="20dp"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/photo_original_user" />

            <ImageView
                android:id="@+id/iconCamera"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/custom_background_circle"
                android:padding="10dp"
                android:src="@drawable/ic_camera"
                app:layout_constraintBottom_toBottomOf="@+id/photoPerfil"
                app:layout_constraintEnd_toEndOf="@+id/photoPerfil" />

            <TextView
                android:id="@+id/texttitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="25dp"
                android:fontFamily="@font/quicksand_bold"
                android:text="Crea tu perfil"
                android:textColor="@color/verde"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/photoPerfil" />

            <!-- Campos de texto -->
            <EditText
                android:id="@+id/editTxtName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/custom_input_general"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="12dp"
                android:hint="Nombre completo"
                android:paddingStart="12dp"
                app:layout_constraintTop_toBottomOf="@+id/texttitle" />

            <EditText
                android:id="@+id/editTxtCelular"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/custom_input_general"
                android:drawableStart="@drawable/ic_phone"
                android:drawablePadding="12dp"
                android:hint="Celular"
                android:inputType="phone"
                android:paddingStart="12dp"
                app:layout_constraintTop_toBottomOf="@+id/editTxtName" />

            <Spinner
                android:id="@+id/spinnerGenero"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/custom_input_general"
                app:layout_constraintTop_toBottomOf="@+id/editTxtCelular" />

            <EditText
                android:id="@+id/editTxtEdad"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/custom_input_general"
                android:hint="Edad"
                android:inputType="number"
                android:paddingStart="12dp"
                app:layout_constraintTop_toBottomOf="@+id/spinnerGenero" />

            <Spinner
                android:id="@+id/spinnerNacionalidad"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/custom_input_general"
                app:layout_constraintTop_toBottomOf="@+id/editTxtEdad" />

            <EditText
                android:id="@+id/editTextTextEmailAddress"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/custom_input_general"
                android:hint="Correo electrónico"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                app:layout_constraintTop_toBottomOf="@+id/spinnerNacionalidad" />

            <!-- Checkbox de Términos -->
            <CheckBox
                android:id="@+id/cbTerminos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="12dp"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/editTextTextEmailAddress" />

            <Button
                android:id="@+id/btnCreateProfile"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/verde"
                android:text="Crear perfil"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@+id/cbTerminos" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>