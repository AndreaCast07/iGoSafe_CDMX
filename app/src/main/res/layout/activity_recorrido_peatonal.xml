<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/recorridoPeatonal"
    tools:context=".recorrido_peatonal">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Texto que puede mostrar la distancia o el tiempo de la ruta -->
    <TextView
        android:id="@+id/textoRuta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:background="@color/verde"
        android:textColor="@color/claro"
        android:padding="10dp"
        android:text="Calculando la ruta..."
        android:textSize="16sp"
        android:layout_marginTop="16dp" />

    <LinearLayout
    android:id="@+id/calificacionLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:layout_centerHorizontal="true"
    android:orientation="horizontal"
    android:layout_marginBottom="80dp"
        android:background="@color/azul5"
    android:padding="10dp"
    android:gravity="center_vertical">

    <!-- RatingBar para mostrar estrellas -->
    <androidx.appcompat.widget.AppCompatRatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="0.5"
        android:progressTint="@color/azul1"
        android:rating="0"
        android:layout_marginEnd="8dp"/>

    <!-- TextView para mostrar la calificación -->
    <TextView
        android:id="@+id/calificacionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="16sp" />

</LinearLayout>

    <!-- Botón para finalizar la ruta -->
    <Button
        android:id="@+id/finalizar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:text="Finalizar Ruta"
        android:backgroundTint="@color/azul1"
        android:textColor="#FFFFFF"
        android:padding="10dp" />

    <!-- Indicador de carga mientras se genera la ruta -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</RelativeLayout>
